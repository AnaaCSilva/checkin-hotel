              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospedes"
              ]
            }
          }
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hospedes/{{hospedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospedes",
                "{{hospedeId}}"
              ]
            }
          }
        },
        {
          "name": "Criar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hospedes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospedes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Lima\",\n  \"cpf\": \"529.982.247-25\",\n  \"telefone\": \"(34) 99999-0003\",\n  \"email\": \"maria@email.com\"\n}"
            }
          }
        },
        {
          "name": "Atualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hospedes/{{hospedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospedes",
                "{{hospedeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Lima Souza\",\n  \"cpf\": \"529.982.247-25\",\n  \"telefone\": \"(34) 99999-0003\",\n  \"email\": \"maria@email.com\"\n}"
            }
          }
        },
        {
          "name": "Excluir",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hospedes/{{hospedeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hospedes",
                "{{hospedeId}}"
              ]
            }
          }
        }
      ]
    },
