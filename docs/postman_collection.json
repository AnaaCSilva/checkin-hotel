            }
          }
        },
        {
          "name": "Excluir (gerente)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quartos/{{quartoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quartos",
                "{{quartoId}}"
