{
  "info": {
    "name": "Check-in Hotel API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode 'Login (gerente)' primeiro: o Postman guarda o cookie de sessao. Ajuste as variaveis hospedeId, quartoId e checkinId conforme os dados do banco."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/mvc"
    },
    {
      "key": "hospedeId",
      "value": "1"
    },
    {
      "key": "quartoId",
      "value": "1"
    },
    {
      "key": "checkinId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Login (gerente)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "login",
                  "value": "gerente"
                },
                {
                  "key": "senha",
                  "value": "gerente123"
                }
              ]
            }
          }
        },
        {
          "name": "Login (recepcionista)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "login",
                  "value": "recepcao1"
                },
                {
                  "key": "senha",
                  "value": "123456"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Hospedes",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
